{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FitBike Content Blocks",
  "type": "array",
  "items": {
    "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["type", "level", "text"], "properties": { "type": { "const": "heading" }, "level": { "enum": [2, 3] }, "text": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": { "type": { "const": "paragraph" }, "text": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "storagePath", "alt"], "properties": { "type": { "const": "image" }, "storagePath": { "type": "string", "minLength": 1 }, "alt": { "type": "string" }, "caption": { "type": "string" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": { "type": { "enum": ["bullet_list", "numbered_list"] }, "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "title", "body"], "properties": { "type": { "const": "step" }, "title": { "type": "string", "minLength": 1 }, "body": { "type": "string", "minLength": 1 }, "number": { "type": "number" } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "body"], "properties": { "type": { "enum": ["tip", "warning"] }, "title": { "type": "string" }, "body": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "headers", "rows"], "properties": { "type": { "const": "table" }, "headers": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } } } }
    ]
  }
}
