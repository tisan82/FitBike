{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitbike.co.kr/schemas/visual-brief-v5",
  "title": "FitBike Stage 2 Visual Brief V5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "image_id",
    "asset_role",
    "user_question",
    "visual_objective",
    "must_show",
    "must_not_show",
    "evidence_requirement",
    "alt_text_draft"
  ],
  "properties": {
    "contract_version": {
      "const": 5
    },
    "image_id": {
      "type": "string",
      "pattern": "^IMG_[0-9]{2,}$",
      "maxLength": 100
    },
    "asset_role": {
      "enum": [
        "THUMBNAIL",
        "HERO",
        "THUMBNAIL_HERO",
        "BODY"
      ]
    },
    "user_question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "visual_objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "must_show": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "must_not_show": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "alt_text_draft": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "evidence_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "NONE",
            "REFERENCE",
            "REQUIRED"
          ]
        },
        "fact_ids": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CF[1-9][0-9]*$"
          }
        },
        "evidence_ref": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_ref"
            ],
            "properties": {
              "source_ref": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://",
                "maxLength": 2000
              },
              "model_scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "supports": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      }
    }
  }
}
